# ─────────────────────────────────────────────
# StudyFlow configuration  (copy to .env)
# ─────────────────────────────────────────────
# StudyFlow never logs into research platforms, so there are NO
# platform passwords here. It is your private, local dashboard.
# The only credentials below are for YOUR OWN dedicated Gmail inbox.

# Web server port
PORT=4173

# Where the local SQLite tracker lives
DB_PATH=./data/zarb.db

# ── Gmail ingest: Option A — IMAP + App Password (recommended) ──
# 1. Create a dedicated Gmail just for research platform signups.
# 2. Turn on 2-Step Verification on that account.
# 3. Create an app password: https://myaccount.google.com/apppasswords
# 4. Paste both below. Done — no Google Cloud project needed.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Gmail ingest: Option B — OAuth (only if you prefer it) ──
# Requires a Google Cloud project with the Gmail API enabled and a
# Web OAuth client. Note: apps left in "Testing" mode get refresh
# tokens that expire every 7 days — Option A avoids all of that.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ── Optional: notify yourself about your OWN follow-ups ──
# These are for reminders you set (e.g. "session at 3pm"), not for
# anything scraped from a platform.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
