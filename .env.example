# ========================================
# Zoom Arbitrage System Configuration
# ========================================
# Copy this to .env and fill in your values

# --- Platform Credentials ---
# Respondent.io
RESPONDENT_EMAIL=
RESPONDENT_PASSWORD=

# User Interviews
USERINTERVIEWS_EMAIL=
USERINTERVIEWS_PASSWORD=

# UserTesting
USERTESTING_EMAIL=
USERTESTING_PASSWORD=

# Prolific
PROLIFIC_EMAIL=
PROLIFIC_PASSWORD=

# dscout
DSCOUT_EMAIL=
DSCOUT_PASSWORD=

# --- Notification Channels ---
# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Slack Webhook URL
SLACK_WEBHOOK_URL=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# --- Monitoring Settings ---
# Check interval in minutes (default: 30)
CHECK_INTERVAL_MINUTES=30

# Minimum pay threshold in USD (only notify for studies above this)
MIN_PAY_THRESHOLD=25

# Maximum study duration in minutes (filter out long studies)
MAX_DURATION_MINUTES=120

# --- Browser Settings ---
# Set to 'true' to run browser in visible mode (useful for debugging)
HEADLESS=true

# Browser user data directory (for persistent sessions)
BROWSER_DATA_DIR=./data/browser-profile
