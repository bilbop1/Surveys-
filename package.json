{
  "name": "study-flow",
  "version": "2.0.0",
  "description": "StudyFlow — a compliant personal control layer for paid UX research participants (tracking, follow-ups, voice, interview prep)",
  "type": "module",
  "main": "server.js",
  "bin": {
    "zarb": "./src/cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "web": "node server.js",
    "seed": "node src/seed.js",
    "track": "node src/cli.js track",
    "stats": "node src/cli.js stats",
    "test": "node --test src/__tests__/"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
