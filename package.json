    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "imapflow": "^1.4.0",
    "inquirer": "^12.1.0",
    "mailparser": "^3.9.9",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "open": "^10.1.0",
    "ora": "^8.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
